  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "GitHub issues for BPO users",
      "source_hash": 9416011878464837599,
      "context_hash": 2425734758877534017,
      "translation": "BPO 사용자를 위한 GitHub 이슈",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437225Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Here are some frequently asked questions about things you used to be able to do on `bpo`_ that work differently in GitHub issues.",
      "source_hash": 8598306966111145970,
      "context_hash": 18266068132084138928,
      "translation": "다음은 이전에는 `bpo`_\\ 에서 할 수 있었지만 GitHub 이슈에서는 다르게 작동하는 기능에 관해 자주 묻는 질문입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437228Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Where did the \"resolution\" field go?",
      "source_hash": 4781334553289544746,
      "context_hash": 13977588929770160461,
      "translation": "\"resolution\" 필드는 어디로 갔습니까?",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437228Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Based on historical data we found it not being used very often.",
      "source_hash": 13659318808505044536,
      "context_hash": 10041724488017299504,
      "translation": "과거 데이터를 바탕으로 이 필드가 자주 사용되지 않았음을 확인했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437229Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Where did the \"low\", \"high\", and \"critical\" priorities go?",
      "source_hash": 464710427292779232,
      "context_hash": 2951116886595679648,
      "translation": "\"low\", \"high\", \"critical\" 우선순위는 어디로 갔습니까?",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437229Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Based on historical data we found those not being used very often.",
      "source_hash": 4185591994611294251,
      "context_hash": 5465368562856232779,
      "translation": "과거 데이터를 바탕으로 이러한 우선순위가 자주 사용되지 않았음을 확인했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437229Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "How to find a random issue?",
      "source_hash": 16981697903595342747,
      "context_hash": 16306181531073441567,
      "translation": "임의의 이슈를 어떻게 찾습니까?",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437230Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "This is not supported by GitHub.",
      "source_hash": 16673215863862002930,
      "context_hash": 13811333573646353238,
      "translation": "GitHub에서는 이를 지원하지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437230Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Where are regression labels?",
      "source_hash": 8476445457499057432,
      "context_hash": 11402810596147811983,
      "translation": "회귀 레이블은 어디에 있습니까?",
      "glossary_snapshot": {
        "regression": "회귀"
      },
      "translated_at": "2026-08-30T20:44:06.437230Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "We rarely updated this information and it turned out not to be particularly useful outside of the change log.",
      "source_hash": 11695751854093524445,
      "context_hash": 9296364371051856542,
      "translation": "이 정보는 거의 업데이트하지 않았으며, 변경 로그 외에서는 그다지 유용하지 않은 것으로 나타났습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:44:06.437231Z",
      "issues": []
    }
  ]
