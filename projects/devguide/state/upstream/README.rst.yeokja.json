    {
      "id": "section:0/block:2/seg:0",
      "source": "This guide covers how to contribute to CPython.",
      "source_hash": 3655586579411051029,
      "context_hash": 16665452727121401814,
      "translation": "이 가이드에서는 CPython에 기여하는 방법을 다룹니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:41:50.943121Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:1",
      "source": "It is known by the nickname of \"the devguide\" by the Python core team.",
      "source_hash": 9763607167934321063,
      "context_hash": 1850616329198544150,
      "translation": "Python 코어 팀에서는 이 가이드를 \"devguide\"라는 별칭으로 부릅니다.",
      "glossary_snapshot": {
        "core team": "코어 팀"
      },
      "translated_at": "2026-08-30T20:41:50.943121Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "The official home of this guide is https://devguide.python.org.",
      "source_hash": 11054915684883458682,
      "context_hash": 145328971955495768,
      "translation": "이 가이드의 공식 홈페이지는 https://devguide.python.org\\ 입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:41:50.943122Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Render HTML",
      "source_hash": 15217102492296166562,
      "context_hash": 13948113558043504895,
      "translation": "HTML 렌더링",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:41:50.943122Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "To render the devguide to HTML under ``_build/html``, run",
      "source_hash": 13832712559210320923,
      "context_hash": 12322722788207214915,
      "translation": "devguide를 ``_build/html``\\ 에 HTML로 렌더링하려면 다음을 실행하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:41:50.943122Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "To render the devguide to HTML, and open the result in a browser, run",
      "source_hash": 9260063169757050110,
      "context_hash": 18439419228292787983,
      "translation": "devguide를 HTML로 렌더링하고 결과를 브라우저에서 열려면 다음을 실행하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:41:50.943123Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "To maintain a live view of edits as they are saved, run",
      "source_hash": 4355332850806246881,
      "context_hash": 6686305324626818838,
      "translation": "편집 내용이 저장될 때마다 실시간으로 확인하려면 다음을 실행하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-30T20:41:50.943123Z",
      "issues": []
    }
