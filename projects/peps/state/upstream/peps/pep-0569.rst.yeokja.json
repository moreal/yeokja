      "id": "section:0/block:0/seg:0",
      "source": "Python 3.8 Release Schedule",
      "source_hash": 12305209487193388297,
      "context_hash": 16530898886277989957,
      "translation": "Python 3.8 릴리스 일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:14:35.674535Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 11164401476953742701,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:14:35.674537Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the development and release schedule for Python 3.8.",
      "source_hash": 6881822840658868946,
      "context_hash": 4441648796028552222,
      "translation": "이 문서는 Python 3.8의 개발 및 릴리스 일정을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:14:35.674538Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The schedule primarily concerns itself with PEP-sized items.",
      "source_hash": 8496237367836649166,
      "context_hash": 8411037446019584100,
      "translation": "이 일정은 주로 PEP 규모의 항목을 다룹니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:14:35.674538Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Release Manager and Crew",
      "source_hash": 17437471849611441175,
      "context_hash": 3973303344149945398,
      "translation": "릴리스 관리자 및 담당 팀",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:14:35.674538Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
