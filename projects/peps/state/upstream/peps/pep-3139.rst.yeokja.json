  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Cleaning out sys and the \"interpreter\" module",
      "source_hash": 9394861597492056452,
      "context_hash": 5664304435715748606,
      "translation": "sys 및 \"인터프리터\" 모듈 정리",
      "glossary_snapshot": {
        "interpreter": "인터프리터"
      },
      "translated_at": "2026-08-28T20:02:19.925833Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Rejection Notice",
      "source_hash": 13288005455860318677,
      "context_hash": 1797464095057653476,
      "translation": "거부 통지",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:26:59.753568Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Guido's -0.5 put an end to this PEP.",
      "source_hash": 4127793099340623354,
      "context_hash": 1195303048939560993,
      "translation": "Guido의 -0.5로 이 PEP는 종료되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:26:59.753568Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "See https://mail.python.org/pipermail/python-3000/2008-April/012977.html.",
      "source_hash": 997039085228982280,
      "context_hash": 5449465051736081598,
      "translation": "다음을 참조하십시오: https://mail.python.org/pipermail/python-3000/2008-April/012977.html.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T20:02:19.925842Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 13196052850093342354,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:26:59.753569Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "This PEP proposes a new low-level module for CPython-specific interpreter functions in order to clean out the sys module and separate general Python functionality from implementation details.",
      "source_hash": 15388776437310732615,
      "context_hash": 10356062162691928027,
      "translation": "이 PEP는 sys 모듈을 정리하고 일반적인 Python 기능을 구현 세부 사항에서 분리하기 위해 CPython 전용 인터프리터 함수를 위한 새로운 저수준 모듈을 제안합니다.",
      "glossary_snapshot": {
        "interpreter": "인터프리터"
      },
      "translated_at": "2026-08-28T19:26:59.753569Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Rationale",
      "source_hash": 18339363210720796208,
      "context_hash": 10610455217819267798,
      "translation": "근거",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:26:59.753570Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "The sys module currently contains functions and data that can be put into two major groups:",
      "source_hash": 12749908337793322992,
      "context_hash": 13498392111303352445,
      "translation": "sys 모듈에는 현재 두 가지 주요 그룹으로 나눌 수 있는 함수와 데이터가 포함되어 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:26:59.753570Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "Data and functions that are available in all Python implementations and deal with the general running of a Python virtual machine.",
      "source_hash": 6436309794600238273,
      "context_hash": 341763919440189916,
      "translation": "모든 Python 구현에서 사용할 수 있고 Python 가상 머신의 일반적인 실행을 다루는 데이터와 함수입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:26:59.753570Z",
      "issues": []
    },
