      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "All active Python core team members are eligible to vote.",
      "source_hash": 16621469274156202773,
      "context_hash": 807863263039117188,
      "translation": "모든 활동 중인 Python 핵심 팀 구성원은 투표할 자격이 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:38.662047Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "Ballots will be distributed based on the `The Python Voter Roll for this election <https://github.com/python/voters/blob/master/2019-01-21-2019-python-steering-committee-election-election.csv>`__ [1]_.",
      "source_hash": 1489757727653828478,
      "context_hash": 963473202973492288,
      "translation": "투표용지는 `The Python Voter Roll for this election <https://github.com/python/voters/blob/master/2019-01-21-2019-python-steering-committee-election-election.csv>`__ [1]_\\ 에 따라 배포됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:38.662048Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "While this file is not public as it contains private email addresses, the `Complete Voter Roll`_ by name is available.",
      "source_hash": 18128989874009264871,
      "context_hash": 4767430620932821770,
      "translation": "이 파일에는 개인 이메일 주소가 포함되어 있어 공개되지 않지만, 이름별 `Complete Voter Roll`_\\ 은 제공됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:38.662048Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Election Implementation",
      "source_hash": 14636875904910317783,
      "context_hash": 8569594482271746273,
      "translation": "선거 구현",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:38.662048Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
