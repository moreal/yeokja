    {
      "id": "section:7/block:3/seg:0",
      "source": "Description: ``Election for the Python steering council, as specified in PEP 13.",
      "source_hash": 16297440336267080939,
      "context_hash": 8200367617272382290,
      "translation": "설명: ``Election for the Python steering council, as specified in PEP 13.",
