    {
      "id": "section:5/block:0/seg:0",
      "source": "Notes",
      "source_hash": 6248434630477978300,
      "context_hash": 5417592378953808514,
      "translation": "참고 사항",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:06:44.762554Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The email package version 2 was distributed with Python up to Python 2.3, and this must remain Python 2.1 compatible.  email package version 3 will be distributed with Python 2.4 and will need to remain compatible only with Python 2.3.",
      "source_hash": 8173297478341084522,
      "context_hash": 10471297597360769510,
      "translation": "email 패키지 버전 2는 Python 2.3까지 Python과 함께 배포되었으며, 이 버전은 Python 2.1과 호환되는 상태로 유지되어야 합니다. email 패키지 버전 3은 Python 2.4와 함께 배포되며 Python 2.3과만 호환되는 상태로 유지되어야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:06:44.762555Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "Specification updates will be treated as bugfixes and backported.",
      "source_hash": 8588903846628998197,
      "context_hash": 7846004602411526485,
      "translation": "사양 업데이트는 버그 수정으로 간주하고 백포트합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:06:44.762555Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:1",
      "source": "Python 2.3 compatibility will be kept for at least Python 2.4.",
      "source_hash": 6457229104913995026,
      "context_hash": 34589839432928149,
      "translation": "Python 2.3 하위 호환성은 최소한 Python 2.4까지 유지합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:06:44.762555Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:2",
      "source": "The decision will be revisited for Python 2.5 and not changed unless compelling advantages arise.",
      "source_hash": 15966262843159428334,
      "context_hash": 14057205076475288885,
      "translation": "이 결정은 Python 2.5에서 재검토하며, 설득력 있는 이점이 발생하지 않는 한 변경하지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:06:44.762556Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "pybench lives under the Tools/ directory.",
      "source_hash": 11266272001363047771,
      "context_hash": 13002755903701947558,
      "translation": "pybench는 Tools/ 디렉터리 아래에 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:33:46.887980Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:1",
      "source": "Compatibility with older Python versions is needed in order to be able to compare performance between Python versions.",
      "source_hash": 11872456834839310952,
      "context_hash": 10379780512336818233,
      "translation": "Python 버전 간 성능을 비교할 수 있으려면 이전 Python 버전과의 호환성이 필요합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:33:46.887983Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:2",
      "source": "New features may still be used in new tests, which may then be configured to fail gracefully on import by the tool in older Python versions.",
      "source_hash": 11492204509972896135,
      "context_hash": 3461830213885497525,
      "translation": "새 테스트에서는 새로운 기능을 사용할 수도 있으며, 이 경우 이전 Python 버전에서 도구가 임포트할 때 정상적으로 실패하도록 구성할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:33:46.887983Z",
      "issues": []
    }
  ]
}