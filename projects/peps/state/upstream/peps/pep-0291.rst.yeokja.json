  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Backward Compatibility for the Python 2 Standard Library",
      "source_hash": 18149396879064270035,
      "context_hash": 16530898886277989957,
      "translation": "Python 2 표준 라이브러리의 하위 호환성",
      "glossary_snapshot": {
        "standard library": "표준 라이브러리",
        "backward compatibility": "하위 호환성"
      },
      "translated_at": "2026-08-28T19:13:30.262429Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 10403051114076096342,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262432Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This PEP describes the packages and modules in the Python 2 standard library which should remain backward compatible with previous versions of Python.",
      "source_hash": 14638491489301909168,
      "context_hash": 15528727877129295513,
      "translation": "이 PEP는 Python 2 표준 라이브러리에서 이전 Python 버전과 하위 호환성을 유지해야 하는 패키지와 모듈을 설명합니다.",
      "glossary_snapshot": {
        "standard library": "표준 라이브러리"
      },
      "translated_at": "2026-08-28T19:13:30.262433Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "If a package is not listed here, then it need only remain compatible with the version of Python it is distributed with.",
      "source_hash": 15035278811979458126,
      "context_hash": 2941019424018879461,
      "translation": "패키지가 여기에 나열되어 있지 않다면, 해당 패키지는 배포된 Python 버전과의 호환성만 유지하면 됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262433Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "This PEP has no bearing on the Python 3 standard library.",
      "source_hash": 8407169603320571312,
      "context_hash": 1073695482656839658,
      "translation": "이 PEP는 Python 3 표준 라이브러리와는 관련이 없습니다.",
      "glossary_snapshot": {
        "standard library": "표준 라이브러리"
      },
      "translated_at": "2026-08-28T19:13:30.262434Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Rationale",
      "source_hash": 18339363210720796208,
      "context_hash": 2842018825091241262,
      "translation": "근거",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262434Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Authors have various reasons why packages and modules should continue to work with previous versions of Python.",
      "source_hash": 5895143564242557703,
      "context_hash": 9458039101163729042,
      "translation": "패키지와 모듈이 이전 Python 버전에서도 계속 작동해야 하는 이유는 저자마다 다양합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262434Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "In order to maintain backward compatibility for these modules while moving the rest of the standard library forward, it is necessary to know which modules can be modified and which should use old and possibly deprecated features.",
      "source_hash": 1172732187672670252,
      "context_hash": 9167601573081948204,
      "translation": "나머지 표준 라이브러리를 발전시키면서 이러한 모듈의 하위 호환성을 유지하려면, 어떤 모듈을 수정할 수 있고 어떤 모듈이 오래되었거나 사용 중단될 가능성이 있는 기능을 사용해야 하는지 알아야 합니다.",
      "glossary_snapshot": {
        "backward compatibility": "하위 호환성",
        "standard library": "표준 라이브러리"
      },
      "translated_at": "2026-08-28T19:13:30.262434Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Generally, authors should attempt to keep changes backward compatible with the previous released version of Python in order to make bug fixes easier to backport.",
      "source_hash": 14366997971262515226,
      "context_hash": 3106951275672403869,
      "translation": "일반적으로 저자는 버그 수정을 더 쉽게 백포팅할 수 있도록 변경 사항을 Python의 이전 릴리스 버전과 하위 호환되게 유지하려고 시도해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262435Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "In addition to a package or module being listed in this PEP, authors must add a comment at the top of each file documenting the compatibility requirement.",
      "source_hash": 8769300384958277440,
      "context_hash": 16538293603545879420,
      "translation": "이 PEP에 패키지나 모듈을 나열하는 것 외에도, 저자는 각 파일의 상단에 호환성 요구 사항을 설명하는 주석을 추가해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262435Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "When a major version of Python is released, a Subversion branch is created for continued maintenance and bug fix releases.",
      "source_hash": 11474460769548147351,
      "context_hash": 2220361233716070793,
      "translation": "Python의 주요 버전이 릴리스되면 지속적인 유지 관리와 버그 수정 릴리스를 위해 Subversion 브랜치가 생성됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262435Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:1",
      "source": "A package version on a branch may have a different compatibility requirement than the same package on the trunk (i.e. current bleeding-edge development).",
      "source_hash": 14650480644178915884,
      "context_hash": 1281790544926149509,
      "translation": "브랜치의 패키지 버전은 트렁크의 동일한 패키지와 다른 호환성 요구 사항을 가질 수 있습니다(즉, 현재의 최신 개발 버전).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262436Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:2",
      "source": "Where appropriate, these branch compatibilities are listed below.",
      "source_hash": 7006927411537591732,
      "context_hash": 17108212048949978166,
      "translation": "해당하는 경우 이러한 브랜치 호환성이 아래에 나열되어 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262436Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Features to Avoid",
      "source_hash": 16751482440446027925,
      "context_hash": 17541163671406147482,
      "translation": "피해야 할 기능",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262436Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "The following list contains common features to avoid in order to maintain backward compatibility with each version of Python.",
      "source_hash": 8099352671363516562,
      "context_hash": 299291703015837499,
      "translation": "다음 목록에는 각 Python 버전과의 하위 호환성을 유지하기 위해 피해야 할 일반적인 기능이 포함되어 있습니다.",
      "glossary_snapshot": {
        "backward compatibility": "하위 호환성"
      },
      "translated_at": "2026-08-28T19:13:30.262437Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "This list is not complete!",
      "source_hash": 3089903523002607502,
      "context_hash": 17568124813286468249,
      "translation": "이 목록은 완전하지 않습니다!",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262437Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:2",
      "source": "It is only meant as a general guide.",
      "source_hash": 13903201562313379276,
      "context_hash": 16729432542253981814,
      "translation": "이는 일반적인 지침으로만 제공됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262437Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "Note that the features below were implemented in the version following the one listed.",
      "source_hash": 17374460431769314590,
      "context_hash": 15578808505110365017,
      "translation": "아래 기능은 나열된 버전의 다음 버전에서 구현되었다는 점에 유의하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262437Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:1",
      "source": "For example, features listed next to 1.5.2 were implemented in 2.0.",
      "source_hash": 10375554633861704777,
      "context_hash": 12139417237134833888,
      "translation": "예를 들어 1.5.2 옆에 나열된 기능은 2.0에서 구현되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:13:30.262438Z",
      "issues": []
    },
    {
