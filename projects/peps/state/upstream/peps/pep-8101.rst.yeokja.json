    },
    {
      "id": "section:7/block:9/seg:0",
      "source": "Voting starts at: ``December 1, 2019 12:00 UTC``",
      "source_hash": 16945330829336582189,
      "context_hash": 9427746858462005705,
      "translation": "투표 시작 시각: ``December 1, 2019 12:00 UTC``",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290100Z",
      "issues": []
    },
    {
      "id": "section:7/block:10/seg:0",
      "source": "Voting ends at: ``December 16, 2019 12:00 UTC``",
      "source_hash": 16906569323691200164,
      "context_hash": 17080429723769604144,
      "translation": "투표 종료 시각: ``December 16, 2019 12:00 UTC``",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290100Z",
      "issues": []
    },
    {
      "id": "section:7/block:11/seg:0",
      "source": "This will create an election in which:",
      "source_hash": 5853243356611201665,
      "context_hash": 1763663851508677828,
      "translation": "다음 조건의 선거를 생성합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290100Z",
      "issues": []
    },
    {
      "id": "section:7/block:12/seg:0",
      "source": "Voting is not open to the public, only those on the `Voter Roll`_ may participate.",
      "source_hash": 12955082363503104037,
      "context_hash": 9435577545546581284,
      "translation": "투표는 공개되지 않으며, `Voter Roll`_\\ 에 등재된 사람만 참여할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290101Z",
      "issues": []
    },
    {
      "id": "section:7/block:12/seg:1",
      "source": "Ballots will be emailed when voting starts.",
      "source_hash": 13123851619577654445,
      "context_hash": 3681668820020388086,
      "translation": "투표가 시작되면 투표용지가 이메일로 발송됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290101Z",
      "issues": []
    },
    {
      "id": "section:7/block:13/seg:0",
      "source": "Candidates are presented in random order, to help avoid bias.",
      "source_hash": 14785501000558521769,
      "context_hash": 17155140882741695243,
      "translation": "편향을 방지하기 위해 후보자는 무작위 순서로 표시됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290101Z",
      "issues": []
    },
    {
      "id": "section:7/block:14/seg:0",
      "source": "Voter identities and ballots are protected against cryptographic advances.",
      "source_hash": 8518556499718116435,
      "context_hash": 4093047784447268713,
      "translation": "투표자의 신원과 투표용지는 암호 기술의 발전에 대비하여 보호됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.290101Z",
      "issues": []
    },
    {
      "id": "section:8/block:0/seg:0",
