  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "2020 Term Steering Council election",
      "source_hash": 16468232861635067312,
      "context_hash": 16530898886277989957,
      "translation": "2020년 임기 운영위원회 선거",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408394Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 10214789290612517903,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408397Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the schedule and other details of the December 2019 election for the Python steering council, as specified in :pep:`13`.",
      "source_hash": 2496046190543348487,
      "context_hash": 10363033031926241703,
      "translation": "이 문서는 :pep:`13`\\ 에 명시된 2019년 12월 파이썬 운영위원회 선거의 일정 및 기타 세부 사항을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408397Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "This is steering council election for the 2020 term.",
      "source_hash": 11810004772910007256,
      "context_hash": 8633902901264348185,
      "translation": "이는 2020년 임기를 위한 운영위원회 선거입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408397Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Election Administration",
      "source_hash": 16550040090148164253,
      "context_hash": 8972320821464619156,
      "translation": "선거 관리",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408397Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The steering council appointed the `Python Software Foundation <https://www.python.org/psf-landing/>`__ Director of Infrastructure, Ee Durbin, to implement the election, and `Python Software Foundation <https://www.python.org/psf-landing/>`__ Executive Director, Ewa Jodlowska, to communicate announcements regarding the election.",
      "source_hash": 7816459545476603087,
      "context_hash": 16543172086966169680,
      "translation": "운영위원회는 선거를 시행할 인프라 책임자로 `Python Software Foundation <https://www.python.org/psf-landing/>`__\\ 의 Ee Durbin을 임명했으며, 선거 관련 공지를 전달할 사무총장으로 `Python Software Foundation <https://www.python.org/psf-landing/>`__\\ 의 Ewa Jodlowska를 임명했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408398Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Schedule",
      "source_hash": 17730507104810335965,
      "context_hash": 12141657456213326646,
      "translation": "일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408398Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "There will be a two-week nomination period, followed by a two-week vote.",
      "source_hash": 1528394639829968729,
      "context_hash": 10627923465141804095,
      "translation": "2주간의 후보 지명 기간에 이어 2주간의 투표가 진행됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408398Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "The nomination period was: November 1, 2019 through November 16, 2019 12:00 UTC (The end of November 15, 2019 `Anywhere on Earth <http://www.ieee802.org/16/aoe.html>`_).",
      "source_hash": 16344653562235849475,
      "context_hash": 4046913173842663966,
      "translation": "후보 지명 기간은 2019년 11월 1일부터 2019년 11월 16일 12:00 UTC까지였습니다(2019년 11월 15일 종료 시점은 `Anywhere on Earth <http://www.ieee802.org/16/aoe.html>`_\\ 입니다).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408398Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:1",
      "source": "As announced on `python-committers <https://mail.python.org/archives/list/python-committers@python.org/thread/4N6WEWVSE6JQ64KDFGQRWFG33MSHRMCK/>`_, and took place on `discuss.python.org <https://discuss.python.org/t/about-the-steering-council-nominations-category/2459>`_.",
      "source_hash": 9810602004540172230,
      "context_hash": 14693530879030467151,
      "translation": "`python-committers <https://mail.python.org/archives/list/python-committers@python.org/thread/4N6WEWVSE6JQ64KDFGQRWFG33MSHRMCK/>`_\\ 에 공지된 대로, `discuss.python.org <https://discuss.python.org/t/about-the-steering-council-nominations-category/2459>`_\\ 에서 진행되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408399Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "The voting period is: December 1, 2019 12:00 UTC through December 16, 2019 12:00 UTC (The end of December 15, 2019 `Anywhere on Earth <http://www.ieee802.org/16/aoe.html>`_).",
      "source_hash": 15816906992955801707,
      "context_hash": 8992063503116787752,
      "translation": "투표 기간은 2019년 12월 1일 12:00 UTC부터 2019년 12월 16일 12:00 UTC까지입니다(2019년 12월 15일 종료 시점은 `Anywhere on Earth <http://www.ieee802.org/16/aoe.html>`_\\ 입니다).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408399Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Candidates",
      "source_hash": 1549024387910241940,
      "context_hash": 7295658369641586241,
      "translation": "후보자",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408399Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Candidates must be nominated by a core team member.",
      "source_hash": 15625689760213116169,
      "context_hash": 520011488141833222,
      "translation": "후보자는 핵심 팀 구성원이 지명해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408399Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "If the candidate is a core team member, they may nominate themselves.",
      "source_hash": 334448297257708624,
      "context_hash": 8233991916457687150,
      "translation": "후보자가 핵심 팀 구성원인 경우에는 자신을 직접 지명할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:27.408399Z",
      "issues": []
    },
