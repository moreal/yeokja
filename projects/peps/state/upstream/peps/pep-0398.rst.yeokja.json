      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "3.3 Lifespan",
      "source_hash": 5325622116586561656,
      "context_hash": 1772631470320863137,
      "translation": "3.3 지원 기간",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341488Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "3.3 will receive bugfix updates approximately every 4-6 months for approximately 18 months.",
      "source_hash": 8600762994950440297,
      "context_hash": 3210732748411511443,
      "translation": "3.3에는 약 18개월 동안 약 4~6개월마다 버그 수정 업데이트가 제공됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341488Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "After the release of 3.4.0 final, a final 3.3 bugfix update will be released.",
      "source_hash": 17932493256647480305,
      "context_hash": 1711842870418216200,
      "translation": "3.4.0 최종 버전이 릴리스된 후, 3.3의 최종 버그 수정 업데이트가 릴리스됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341488Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:2",
      "source": "After that, security updates (source only) will be released until 5 years after the release of 3.3 final, which will be September 2017.",
      "source_hash": 1366797634784372274,
      "context_hash": 17528189555229534603,
      "translation": "그 후에는 3.3 최종 버전 릴리스 후 5년이 되는 시점인 2017년 9월까지 보안 업데이트(소스만)가 릴리스됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341488Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "As of 2017-09-29, Python 3.3.x reached end-of-life status.",
      "source_hash": 16224474596421472702,
      "context_hash": 1455607578844205032,
      "translation": "2017년 9월 29일을 기준으로 Python 3.3.x는 지원 종료 상태에 도달했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341488Z",
      "issues": []
    },
