    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 12098124610177599696,
      "translation": "개요",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341486Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the development and release schedule for Python 3.3.",
      "source_hash": 9097999583477527674,
      "context_hash": 4441648796028552222,
      "translation": "이 문서는 Python 3.3의 개발 및 릴리스 일정을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341486Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The schedule primarily concerns itself with PEP-sized items.",
      "source_hash": 8496237367836649166,
      "context_hash": 16571368400738049265,
      "translation": "이 일정은 주로 PEP 규모의 항목을 대상으로 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:05:53.341486Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
