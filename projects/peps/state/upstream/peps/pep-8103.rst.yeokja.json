  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "2022 Term Steering Council election",
      "source_hash": 11669618855426487067,
      "context_hash": 16530898886277989957,
      "translation": "2022년 임기 운영위원회 선거",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566796Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 5894593830657533510,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566798Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the schedule and other details of the December 2021 election for the Python steering council, as specified in :pep:`13`.",
      "source_hash": 15150702327299696698,
      "context_hash": 7383309921975003702,
      "translation": "이 문서는 :pep:`13`\\ 에 명시된 2021년 12월 Python 운영위원회 선거의 일정과 기타 세부 사항을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566798Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "This is the steering council election for the 2022 term (i.e. Python 3.11).",
      "source_hash": 15423454209286690533,
      "context_hash": 10418742546013557217,
      "translation": "이는 2022년 임기(즉, Python 3.11)를 위한 운영위원회 선거입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566798Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Election Administration",
      "source_hash": 16550040090148164253,
      "context_hash": 13238455126304453776,
      "translation": "선거 관리",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566799Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The steering council appointed the `Python Software Foundation <https://www.python.org/psf-landing/>`__ Director of Infrastructure, Ee Durbin and Accounting Manager, Joe Carey, to coadminister the election.",
      "source_hash": 18402362368797729216,
      "context_hash": 16543172086966169680,
      "translation": "운영위원회는 `Python Software Foundation <https://www.python.org/psf-landing/>`__\\ 의 인프라 담당 이사 Ee Durbin과 회계 관리자 Joe Carey를 선거 공동 관리자로 임명했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566799Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Schedule",
      "source_hash": 17730507104810335965,
      "context_hash": 12858027140268466938,
      "translation": "일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566799Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "There will be a two-week nomination period, followed by a two-week vote.",
      "source_hash": 1528394639829968729,
      "context_hash": 9324339805317204296,
      "translation": "2주간의 후보 추천 기간 후에 2주간의 투표 기간이 진행됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566799Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "The nomination period was: November 1, 2021 through November 16, 2021 12:00 UTC (The end of November 15, 2021 `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "source_hash": 3420617632539348786,
      "context_hash": 2753384357185260907,
      "translation": "후보 추천 기간은 2021년 11월 1일부터 2021년 11월 16일 12:00 UTC까지였습니다(2021년 11월 15일 종료 시점, `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566799Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:1",
      "source": "As announced on `python-committers <https://mail.python.org/archives/list/python-committers@python.org/thread/6WDCGUKBOVG2FIPOGTPYXD3OA2KDJLLO/>`_, and took place on `discuss.python.org <https://discuss.python.org/c/core-dev/steering-council-nominations>`_.",
      "source_hash": 10434454880727179826,
      "context_hash": 2264697533198155718,
      "translation": "`python-committers <https://mail.python.org/archives/list/python-committers@python.org/thread/6WDCGUKBOVG2FIPOGTPYXD3OA2KDJLLO/>`_\\ 에서 발표된 바와 같이, `discuss.python.org <https://discuss.python.org/c/core-dev/steering-council-nominations>`_\\ 에서 진행되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566799Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "The voting period is: December 1, 2021 12:00 UTC through December 16, 2021 12:00 UTC (The end of December 15, 2021 `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "source_hash": 18389842499283574307,
      "context_hash": 15679851647037960647,
      "translation": "투표 기간은 2021년 12월 1일 12:00 UTC부터 2021년 12월 16일 12:00 UTC까지입니다(2021년 12월 15일 종료 시점, `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566800Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Candidates",
      "source_hash": 1549024387910241940,
      "context_hash": 7595043422340675103,
      "translation": "후보자",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566800Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Candidates must be nominated by a core team member.",
      "source_hash": 15625689760213116169,
      "context_hash": 520011488141833222,
      "translation": "후보자는 핵심 팀 구성원이 추천해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566800Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "If the candidate is a core team member, they may nominate themselves.",
      "source_hash": 334448297257708624,
      "context_hash": 8233991916457687150,
      "translation": "후보자가 핵심 팀 구성원인 경우에는 스스로를 추천할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:30.566800Z",
      "issues": []
    },
