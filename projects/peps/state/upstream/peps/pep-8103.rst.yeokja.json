      "issues": []
    },
    {
      "id": "section:7/block:2/seg:0",
      "source": "Name: ``2022 Python Steering Council Election``",
      "source_hash": 15462375874713203801,
      "context_hash": 126173692548070291,
      "translation": "이름: ``2022 Python Steering Council Election``",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:32.944233Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "Description: ``Election for the Python steering council, as specified in PEP 13.",
      "source_hash": 16297440336267080939,
      "context_hash": 10790465903358659347,
      "translation": "설명: ``Python 운영 위원회를 위한 선거이며, PEP 13에 명시된 내용에 따릅니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:32.944233Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:1",
      "source": "This is steering council election for the 2022 term.``",
      "source_hash": 6664861583815617038,
      "context_hash": 3963549613760772605,
      "translation": "이는 2022년 임기를 위한 운영 위원회 선거입니다.``",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:32.944233Z",
      "issues": []
    },
    {
      "id": "section:7/block:4/seg:0",
      "source": "type: ``Election``",
      "source_hash": 3508758751667272147,
      "context_hash": 9327046617907419138,
      "translation": "유형: ``Election``",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:32.944234Z",
      "issues": []
    },
    {
      "id": "section:7/block:5/seg:0",
