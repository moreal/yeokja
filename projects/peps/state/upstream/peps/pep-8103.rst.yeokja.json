      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:21:32.944232Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "Short name: ``2022-python-steering-council``",
      "source_hash": 15835535078292205538,
      "context_hash": 3994387391683355959,
      "translation": "짧은 이름: ``2022-python-steering-council``",
