    {
      "id": "section:15/block:1/seg:0",
      "source": "The PEP was rejected on 2017-09-12 by Victor Stinner.",
      "source_hash": 17675572147188070663,
      "context_hash": 9893550311452263648,
      "translation": "이 PEP는 2017년 9월 12일 Victor Stinner에 의해 거부되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:20:22.659124Z",
      "issues": []
    },
    {
      "id": "section:15/block:1/seg:1",
      "source": "It was decided in the python-dev discussion to not chain C exceptions by default, but instead chain them explicitly only where it makes sense.",
      "source_hash": 4805116073061355579,
      "context_hash": 17522654483756833762,
      "translation": "python-dev 논의에서 C 예외를 기본적으로 연쇄시키지 않고, 의미가 있는 경우에만 명시적으로 연쇄시키기로 결정되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:20:22.659125Z",
      "issues": []
    }
