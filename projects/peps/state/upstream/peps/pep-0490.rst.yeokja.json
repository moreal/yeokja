    },
    {
      "id": "section:6/block:20/seg:0",
      "source": "Examples of function displaying the new exception to ``sys.stderr``:",
      "source_hash": 12502189921016246095,
      "context_hash": 7703858547651969430,
      "translation": "새 예외를 ``sys.stderr``\\ 에 표시하는 함수의 예시는 다음과 같습니다.",
      "glossary_snapshot": {},
