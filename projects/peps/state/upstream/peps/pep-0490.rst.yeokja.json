      "source_hash": 16147618996556442016,
      "context_hash": 4882132641763154509,
      "translation": "``_PyGen_Finalize()``\\ : ``PyErr_WriteUnraisable()``\\ 로 ``gen_close()``\\ 예외를 표시합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:03:37.901564Z",
      "issues": []
    },
    {
      "id": "section:6/block:25/seg:0",
