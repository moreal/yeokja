      "source_hash": 16495925606763641868,
      "context_hash": 4884031364522658599,
      "translation": "다음 매크로와 함수는 ``Py_DEPRECATED`` 매크로를 사용하여 더 이상 사용하지 않는 것으로 표시합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:33:47.076715Z",
      "issues": []
    },
