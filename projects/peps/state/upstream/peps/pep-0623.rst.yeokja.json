    {
      "id": "section:12/block:22/seg:0",
      "source": "``PyUnicode_FromStringAndSize(NULL, size))`` raises ``RuntimeError`` when ``size > 0``.",
      "source_hash": 2882899762608380339,
      "context_hash": 14843488139445493131,
      "translation": "``PyUnicode_FromStringAndSize(NULL, size))``\\ 은 ``size > 0``\\ 일 때 ``RuntimeError``\\ 를 발생시킵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:22:44.408630Z",
      "issues": []
    },
    {
      "id": "section:12/block:23/seg:0",
      "source": "``PyArg_ParseTuple()`` and ``PyArg_ParseTupleAndKeywords()`` raise ``SystemError`` when ``u``, ``u#``, ``Z``, and ``Z#`` formats are used, as other unsupported format character.",
      "source_hash": 1574823517487053064,
      "context_hash": 3909375239010981900,
      "translation": "``PyArg_ParseTuple()``\\ 과 ``PyArg_ParseTupleAndKeywords()``\\ 는 ``u``, ``u#``, ``Z``, ``Z#`` 형식을 사용할 때 다른 지원되지 않는 형식 문자와 마찬가지로 ``SystemError``\\ 를 발생시킵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:22:44.408631Z",
      "issues": []
    },
