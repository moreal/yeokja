  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Dependency specification in pyproject.toml based on PEP 508",
      "source_hash": 15616059251839111666,
      "context_hash": 16530898886277989957,
      "translation": "PEP 508 기반 pyproject.toml 의존성 명세",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046719Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 5777683648949850351,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046726Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This PEP specifies how to write a project's dependencies in a ``pyproject.toml`` file for packaging-related tools to consume using the :pep:`fields defined in PEP 621 <621#dependencies-optional-dependencies>`.",
      "source_hash": 2379193241343369205,
      "context_hash": 3935012674910488023,
      "translation": "이 PEP는 패키징 관련 도구가 사용할 수 있도록, 프로젝트의 의존성을 ``pyproject.toml`` 파일에 :pep:`PEP 621에 정의된 필드 <621#dependencies-optional-dependencies>`\\ 를 사용하여 작성하는 방법을 규정합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046727Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "This PEP has been accepted and was merged into :pep:`621`.",
      "source_hash": 12907541950421487394,
      "context_hash": 1695011417496952375,
      "translation": "이 PEP는 승인되어 :pep:`621`\\ 에 병합되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046729Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Entries",
      "source_hash": 4489749328304850418,
      "context_hash": 8986989899822904272,
      "translation": "항목",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046729Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "All dependency entries MUST be valid :pep:`PEP 508 strings <508>`.",
      "source_hash": 9191998435826690650,
      "context_hash": 17019348581578617012,
      "translation": "모든 의존성 항목은 유효한 :pep:`PEP 508 문자열 <508>`\\ 이어야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046730Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Build backends SHOULD abort at load time for any parsing errors.",
      "source_hash": 535504348130843512,
      "context_hash": 8980883568132464939,
      "translation": "빌드 백엔드는 파싱 오류가 발생하면 로드 시점에 중단해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046730Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Specification",
      "source_hash": 12978730460824815227,
      "context_hash": 899870362561722926,
      "translation": "명세",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046730Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "dependencies",
      "source_hash": 13585692780513774030,
      "context_hash": 505099363384343891,
      "translation": "dependencies",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046731Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Format: array of strings",
      "source_hash": 8105551160044070071,
      "context_hash": 7278457572685599700,
      "translation": "형식: 문자열 배열",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:35:25.046732Z",
      "issues": []
    },
    {
