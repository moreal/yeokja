      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
      "source": "Each key is the name of the provided option, with each value being the same type as the `dependencies <#dependencies>`_ field i.e. an array of strings.",
      "source_hash": 1424149395566831522,
      "context_hash": 13150003439218962469,
      "translation": "각 키는 제공된 옵션의 이름이며, 각 값은 `dependencies <#dependencies>`_ 필드와 동일한 타입, 즉 문자열의 배열입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:24:33.010540Z",
      "issues": []
    },
    {
