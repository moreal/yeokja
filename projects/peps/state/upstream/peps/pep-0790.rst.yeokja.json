    {
      "id": "section:4/block:20/seg:0",
      "source": "Subsequent bugfix releases every two months.",
      "source_hash": 1156579515598563222,
      "context_hash": 1987579661747205509,
      "translation": "이후 버그 수정 릴리스는 두 달마다 진행됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:27:12.608688Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "3.15 lifespan",
      "source_hash": 14347221714011731445,
      "context_hash": 15033373357953323034,
      "translation": "3.15 수명",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:27:12.608688Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Python 3.15 will receive bugfix updates approximately every second month for two years.",
      "source_hash": 17041180332885859625,
      "context_hash": 5624913165989301500,
      "translation": "Python 3.15는 2년 동안 대략 두 달마다 버그 수정 업데이트를 받습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:27:12.608689Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "Around the time of the release of 3.17.0 final, the final 3.15 bugfix update will be released.",
      "source_hash": 5876340508700452401,
      "context_hash": 14490117525642582909,
      "translation": "3.17.0 final이 출시될 무렵, 최종 3.15 버그 수정 업데이트가 출시됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:19:09.308818Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "After that, it is expected that security updates (source only) will be released for the next three years, until five years after the release of 3.15.0 final, so until approximately October 2031.",
      "source_hash": 3451153702175235218,
      "context_hash": 5127676977155905048,
      "translation": "그 후에는 3.15.0 final 출시 후 5년이 되는 시점까지, 즉 대략 2031년 10월까지 향후 3년 동안 보안 업데이트(소스만)가 출시될 것으로 예상됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:19:09.308828Z",
      "issues": []
    }
  ]
