  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "2025 Term Steering Council election",
      "source_hash": 4397679797922959320,
      "context_hash": 16530898886277989957,
      "translation": "2025년 임기 운영위원회 선거",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296652Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 5610968341416796051,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296655Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the schedule and other details of the 2024 election for the Python steering council, as specified in :pep:`13`.",
      "source_hash": 1003715621861207038,
      "context_hash": 6044904370132974631,
      "translation": "이 문서는 :pep:`13`\\ 에 명시된 Python 운영위원회의 2024년 선거 일정 및 기타 세부 사항을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296655Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "This is the steering council election for the 2025 term (i.e. Python 3.14).",
      "source_hash": 9330683287336883168,
      "context_hash": 1303873473063458800,
      "translation": "이는 2025년 임기(즉, Python 3.14)를 위한 운영위원회 선거입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296655Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Election Administration",
      "source_hash": 16550040090148164253,
      "context_hash": 4082185646376227657,
      "translation": "선거 관리",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296656Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The steering council appointed the `Python Software Foundation <https://www.python.org/psf-landing/>`__ Director of Infrastructure, Ee Durbin, to administer the election.",
      "source_hash": 4963720401124199556,
      "context_hash": 16543172086966169680,
      "translation": "운영위원회는 `Python Software Foundation <https://www.python.org/psf-landing/>`__ 인프라 디렉터인 Ee Durbin을 선거 관리자로 임명했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296656Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Schedule",
      "source_hash": 17730507104810335965,
      "context_hash": 13078330570867213753,
      "translation": "일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296656Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "There was a two-week nomination period, followed by a two-week vote.",
      "source_hash": 83966262288438113,
      "context_hash": 13074105579574481523,
      "translation": "2주간의 후보 추천 기간에 이어 2주간의 투표 기간이 있었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296657Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "The nomination period was: November 7, 2024 through `November 21, 2024 AoE <https://www.timeanddate.com/worldclock/fixedtime.html?msg=Python+Steering+Council+nominations+close&iso=20241122T00&p1=3399>`_ [#note-aoe]_.",
      "source_hash": 6665707005916329285,
      "context_hash": 14869141086500701319,
      "translation": "후보 추천 기간은 2024년 11월 7일부터 `2024년 11월 21일 AoE <https://www.timeanddate.com/worldclock/fixedtime.html?msg=Python+Steering+Council+nominations+close&iso=20241122T00&p1=3399>`_ [#note-aoe]_\\ 까지였습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296657Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "The voting period was: November 25, 2024 through `December 9, 2024 AoE <https://www.timeanddate.com/worldclock/fixedtime.html?msg=Python+Steering+Council+voting+closes&iso=20241210T00&p1=3399>`_ [#note-aoe]_.",
      "source_hash": 6613441390261614313,
      "context_hash": 15786632295404861211,
      "translation": "투표 기간은 2024년 11월 25일부터 `2024년 12월 9일 AoE <https://www.timeanddate.com/worldclock/fixedtime.html?msg=Python+Steering+Council+voting+closes&iso=20241210T00&p1=3399>`_ [#note-aoe]_\\ 까지였습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296657Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Candidates",
      "source_hash": 1549024387910241940,
      "context_hash": 7647308100780060790,
      "translation": "후보자",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296658Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Candidates must be nominated by a core team member.",
      "source_hash": 15625689760213116169,
      "context_hash": 520011488141833222,
      "translation": "후보자는 핵심 팀 구성원이 추천해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296658Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "If the candidate is a core team member, they may nominate themselves.",
      "source_hash": 334448297257708624,
      "context_hash": 6017710446542411990,
      "translation": "후보자가 핵심 팀 구성원인 경우에는 스스로를 추천할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:39:07.296658Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:0",
