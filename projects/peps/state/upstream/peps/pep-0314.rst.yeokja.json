      "issues": []
    },
    {
      "id": "section:21/block:2/seg:0",
      "source": "Added the Classifiers field from :pep:`301`.",
      "source_hash": 12853673240685199971,
      "context_hash": 13415167682878004601,
      "translation": "Classifiers 필드를 :pep:`301`\\ 에서 추가했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:45:36.908661Z",
      "issues": []
    },
    {
      "id": "section:21/block:3/seg:0",
      "source": "The License and Platform files should now only be used if the platform or license can't be handled by an appropriate Classifier value.",
      "source_hash": 4381428238406410027,
      "context_hash": 17944038884765237725,
      "translation": "이제 라이선스 및 플랫폼 파일은 플랫폼이나 라이선스를 적절한 Classifier 값으로 처리할 수 없는 경우에만 사용해야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:18:50.057044Z",
      "issues": []
    },
    {
      "id": "section:21/block:4/seg:0",
