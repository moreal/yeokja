    {
      "id": "section:4/block:19/seg:0",
      "source": "Subsequent bugfix releases every two months.",
      "source_hash": 1156579515598563222,
      "context_hash": 10348084111493433731,
      "translation": "이후 버그 수정 릴리스는 2개월마다 진행됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:20:38.976499Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "3.16 lifespan",
      "source_hash": 1168588456696150888,
      "context_hash": 12385103080769339641,
      "translation": "3.16 수명 주기",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:20:38.976500Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Python 3.16 will receive bugfix updates approximately every second month for two years.",
      "source_hash": 2949060888433171783,
      "context_hash": 14707379656412069559,
      "translation": "Python 3.16은 2년 동안 대략 두 달에 한 번씩 버그 수정 업데이트를 받습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:20:38.976500Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "Around the time of the release of 3.18.0 final, the final 3.16 bugfix update will be released.",
      "source_hash": 57911294581805099,
      "context_hash": 16418965191946312342,
      "translation": "3.18.0 최종 릴리스 시점 전후에 3.16의 마지막 버그 수정 업데이트가 릴리스됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:20:38.976500Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "After that, it is expected that security updates (source only) will be released for the next three years, until five years after the release of 3.16.0 final, so until approximately October 2032.",
      "source_hash": 8667142130995215840,
      "context_hash": 10853583483254703571,
      "translation": "그 이후에는 보안 업데이트(소스만)가 향후 3년 동안, 3.16.0 최종 버전 출시 후 5년이 되는 시점까지, 즉 대략 2032년 10월까지 릴리스될 것으로 예상됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:22:25.232078Z",
      "issues": []
    }
  ]
