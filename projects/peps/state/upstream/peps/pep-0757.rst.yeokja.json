      "issues": []
    },
    {
      "id": "section:18/block:3/seg:0",
      "source": "`Pull request #121339 <https://github.com/python/cpython/pull/121339>`_",
      "source_hash": 8894583978572314088,
      "context_hash": 16088575745872985375,
      "translation": "`풀 리퀘스트 #121339 <https://github.com/python/cpython/pull/121339>`_",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:16:47.257032Z",
      "issues": []
    },
    {
      "id": "section:18/block:4/seg:0",
      "source": "`Issue #102471 <https://github.com/python/cpython/issues/102471>`_: The C-API for Python to C integer conversion is, to be frank, a mess.",
      "source_hash": 4210237702328085450,
      "context_hash": 11573945859061361395,
      "translation": "`이슈 #102471 <https://github.com/python/cpython/issues/102471>`_: Python 정수를 C 정수로 변환하는 C API는 솔직히 말해 엉망입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:16:47.257033Z",
      "issues": []
    },
    {
      "id": "section:18/block:5/seg:0",
      "source": "`Add public function PyLong_GetDigits() <https://github.com/capi-workgroup/decisions/issues/31>`_",
      "source_hash": 17935435924324109416,
      "context_hash": 17437033261009603984,
      "translation": "`공개 함수 PyLong_GetDigits() 추가 <https://github.com/capi-workgroup/decisions/issues/31>`_",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:16:47.257033Z",
      "issues": []
    },
    {
      "id": "section:18/block:6/seg:0",
      "source": "`Consider restoring _PyLong_New() function as public <https://github.com/python/cpython/issues/111415>`_",
      "source_hash": 1543113794450544205,
      "context_hash": 6524972435483307093,
      "translation": "`_PyLong_New() 함수를 공개 함수로 복원하는 것을 고려 <https://github.com/python/cpython/issues/111415>`_",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:16:47.257033Z",
      "issues": []
    },
    {
      "id": "section:18/block:7/seg:0",
      "source": "`Pull request gh-106320 <https://github.com/python/cpython/pull/108604>`_: Remove private _PyLong_New() function.",
      "source_hash": 3065540120107266955,
      "context_hash": 12095219282681559817,
      "translation": "`풀 리퀘스트 gh-106320 <https://github.com/python/cpython/pull/108604>`_: 비공개 _PyLong_New() 함수를 제거합니다.",
