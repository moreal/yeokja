      "source_hash": 16149067412748462865,
      "context_hash": 2551363962884706139,
      "translation": "할당 표현식을 사용한 경우",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:26:00.580775Z",
      "issues": []
    },
    {
      "id": "section:5/block:6/seg:0",
      "source": "Original",
