    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Examples",
      "source_hash": 2926230321239078022,
      "context_hash": 7333905902905225171,
      "translation": "예제",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:26:00.580776Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "The examples shown below highlight some of the desirable features of the assignment expression, and some of the possible corner cases.",
      "source_hash": 12305493844377274505,
      "context_hash": 4756260286523716144,
      "translation": "아래 예제들은 할당 표현식의 바람직한 특징 몇 가지와 발생 가능한 몇 가지 코너 케이스를 보여줍니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:22:20.447321Z",
      "issues": []
    },
    {
      "id": "section:6/block:2/seg:0",
      "source": "Assignment in an if statement for use later",
      "source_hash": 13109281027989658544,
      "context_hash": 16338619899747708682,
      "translation": "이후 사용을 위해 if 문에서 할당하기",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:22:20.447324Z",
      "issues": []
    },
    {
      "id": "section:6/block:4/seg:0",
      "source": "Assignment in a while loop clause",
      "source_hash": 15504661608457016670,
      "context_hash": 8607563731950822566,
      "translation": "while 루프 절에서 할당하기",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:22:20.447324Z",
      "issues": []
    },
    {
      "id": "section:6/block:6/seg:0",
      "source": "Keep the iterator object from the for loop",
      "source_hash": 14594218498099617677,
      "context_hash": 11761752590964095669,
      "translation": "for 루프의 이터레이터 객체 유지하기",
      "glossary_snapshot": {
        "iterator": "이터레이터"
      },
      "translated_at": "2026-08-28T17:22:20.447324Z",
      "issues": []
    },
