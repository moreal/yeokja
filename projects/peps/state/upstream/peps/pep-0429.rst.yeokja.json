      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the development and release schedule for Python 3.4.",
      "source_hash": 17343804039916856817,
      "context_hash": 4441648796028552222,
      "translation": "이 문서는 Python 3.4의 개발 및 릴리스 일정을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:07.785414Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The schedule primarily concerns itself with PEP-sized items.",
      "source_hash": 8496237367836649166,
      "context_hash": 15078493062741780861,
      "translation": "이 일정은 주로 PEP 규모의 항목을 다룹니다.",
