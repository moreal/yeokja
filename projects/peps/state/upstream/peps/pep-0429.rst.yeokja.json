      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Python 3.4 has now reached its end-of-life and has been retired.",
      "source_hash": 17569167203007975393,
      "context_hash": 7571997234216575472,
      "translation": "Python 3.4는 이제 지원 종료에 도달했으며 폐기되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:07.785416Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "No more releases will be made.",
      "source_hash": 12332462178947268684,
      "context_hash": 16110153179630828935,
      "translation": "더 이상 릴리스되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:07.785416Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
