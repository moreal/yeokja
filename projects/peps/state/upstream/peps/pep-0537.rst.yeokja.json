      "id": "section:0/block:0/seg:0",
      "source": "Python 3.7 Release Schedule",
      "source_hash": 5095974481674905633,
      "context_hash": 16530898886277989957,
      "translation": "Python 3.7 릴리스 일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395081Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 7302923794183366376,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395084Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the development and release schedule for Python 3.7.",
      "source_hash": 6174707831479727311,
      "context_hash": 4441648796028552222,
      "translation": "이 문서는 Python 3.7의 개발 및 릴리스 일정을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395084Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The schedule primarily concerns itself with PEP-sized items.",
      "source_hash": 8496237367836649166,
      "context_hash": 6380647704063809914,
      "translation": "이 일정은 주로 PEP 규모의 항목을 다룹니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395084Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Release Manager and Crew",
      "source_hash": 17437471849611441175,
      "context_hash": 822089672261641752,
      "translation": "릴리스 관리자 및 팀",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395084Z",
      "issues": []
    },
    {
