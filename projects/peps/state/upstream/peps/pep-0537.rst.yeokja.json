      "context_hash": 16931721154163718027,
      "translation": "3.7 릴리스 관리자: Ned Deily",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395084Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Windows installers: Steve Dower",
      "source_hash": 2962025219427909861,
      "context_hash": 9890477678536282757,
      "translation": "Windows 설치 관리자: Steve Dower",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:08:27.395085Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
