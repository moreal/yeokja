    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the development and release schedule for Python 3.5.",
      "source_hash": 2434952774114203608,
      "context_hash": 4441648796028552222,
      "translation": "이 문서는 Python 3.5의 개발 및 릴리스 일정을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:56.267562Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The schedule primarily concerns itself with PEP-sized items.",
      "source_hash": 8496237367836649166,
      "context_hash": 8271259976647994803,
      "translation": "이 일정은 주로 PEP 규모의 항목을 다룹니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:56.267563Z",
      "issues": []
