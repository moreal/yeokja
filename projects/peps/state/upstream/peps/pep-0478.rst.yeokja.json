      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Python 3.5 has now reached its end-of-life and has been retired.",
      "source_hash": 12453117373412164429,
      "context_hash": 7571997234216575472,
      "translation": "Python 3.5는 이제 수명이 종료되었으며 폐기되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:56.267564Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "No more releases will be made.",
      "source_hash": 12332462178947268684,
      "context_hash": 16260578109491113830,
      "translation": "더 이상 릴리스되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:08:56.267564Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "These are all the historical releases of Python 3.5, including their release dates.",
