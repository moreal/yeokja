  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "2021 Term Steering Council election",
      "source_hash": 10464162389824038448,
      "context_hash": 16530898886277989957,
      "translation": "2021년 임기 운영위원회 선거",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142098Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 15055466219851208862,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142103Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the schedule and other details of the December 2020 election for the Python steering council, as specified in :pep:`13`.",
      "source_hash": 17074312872145584032,
      "context_hash": 5291951052662777042,
      "translation": "이 문서는 :pep:`13`\\ 에 명시된 Python 운영위원회의 2020년 12월 선거 일정과 기타 세부 사항을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142103Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "This is the steering council election for the 2021 term.",
      "source_hash": 17049320783742871343,
      "context_hash": 11484687349607506097,
      "translation": "이는 2021년 임기를 위한 운영위원회 선거입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142104Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Election Administration",
      "source_hash": 16550040090148164253,
      "context_hash": 4567490671128130048,
      "translation": "선거 관리",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142104Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The steering council appointed the `Python Software Foundation <https://www.python.org/psf-landing/>`__ Director of Infrastructure, Ee Durbin, and Accounting Manager, Joe Carey, to coadminister the election.",
      "source_hash": 2671602510963858740,
      "context_hash": 5217557934378307392,
      "translation": "운영위원회는 선거를 공동 관리하도록 `Python Software Foundation <https://www.python.org/psf-landing/>`__ 인프라 이사 Ee Durbin과 회계 관리자 Joe Carey를 임명했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142104Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "`Python Software Foundation <https://www.python.org/psf-landing/>`__ Executive Director, Ewa Jodlowska, will communicate announcements regarding the election.",
      "source_hash": 17827132107233235981,
      "context_hash": 10923656208988434849,
      "translation": "`Python Software Foundation <https://www.python.org/psf-landing/>`__ 사무총장 Ewa Jodlowska가 선거 관련 공지를 전달합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142105Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Schedule",
      "source_hash": 17730507104810335965,
      "context_hash": 8056853687224159449,
      "translation": "일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142105Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "There will be a two-week nomination period, followed by a two-week vote.",
      "source_hash": 1528394639829968729,
      "context_hash": 14823418709075866923,
      "translation": "2주간의 후보 추천 기간에 이어 2주간의 투표 기간이 진행됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142105Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "The nomination period was: November 1, 2020 through November 16, 2020 12:00 UTC (The end of November 15, 2020 `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "source_hash": 330937166770412876,
      "context_hash": 11798757153502464435,
      "translation": "후보 추천 기간은 2020년 11월 1일부터 2020년 11월 16일 12:00 UTC까지였습니다(2020년 11월 15일 종료 시점 `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142106Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:1",
      "source": "As announced on `python-committers <https://mail.python.org/archives/list/python-committers@python.org/thread/JHYSU6FEYM3A5AZXSICO5OE3VAWDPGEJ/>`_, and took place on `discuss.python.org <https://discuss.python.org/c/core-dev/steering-council-nominations>`_.",
      "source_hash": 13681617274504851355,
      "context_hash": 14227074047606843332,
      "translation": "`python-committers <https://mail.python.org/archives/list/python-committers@python.org/thread/JHYSU6FEYM3A5AZXSICO5OE3VAWDPGEJ/>`_\\ 에 발표된 바와 같이, `discuss.python.org <https://discuss.python.org/c/core-dev/steering-council-nominations>`_\\ 에서 진행되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142106Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "The voting period is: December 1, 2020 12:00 UTC through December 16, 2020 12:00 UTC (The end of December 15, 2020 `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "source_hash": 8374266694918941843,
      "context_hash": 17541982881950568772,
      "translation": "투표 기간은 2020년 12월 1일 12:00 UTC부터 2020년 12월 16일 12:00 UTC까지입니다(2020년 12월 15일 종료 시점 `Anywhere on Earth <https://www.ieee802.org/16/aoe.html>`_).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142106Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Candidates",
      "source_hash": 1549024387910241940,
      "context_hash": 18082459980127628205,
      "translation": "후보자",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142106Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Candidates must be nominated by a core team member.",
      "source_hash": 15625689760213116169,
      "context_hash": 520011488141833222,
      "translation": "후보자는 핵심 팀 구성원의 추천을 받아야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142107Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "If the candidate is a core team member, they may nominate themselves.",
      "source_hash": 334448297257708624,
      "context_hash": 8233991916457687150,
      "translation": "후보자가 핵심 팀 구성원인 경우 스스로를 추천할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:40:35.142107Z",
      "issues": []
    },
