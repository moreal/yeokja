      "glossary_snapshot": {},
      "translated_at": "2026-08-28T18:28:48.702432Z",
      "issues": []
    },
    {
      "id": "section:8/block:3/seg:0",
      "source": ":pep:`657`, Enhanced error locations in tracebacks.",
      "source_hash": 16667272238100186234,
      "context_hash": 300208442124318811,
      "translation": ":pep:`657`, 트레이스백의 향상된 오류 위치.",
      "glossary_snapshot": {},
