      "context_hash": 11163428238611581739,
      "translation": "`Pablo Galindo Salgado <https://discuss.python.org/t/steering-council-nomination-pablo-galindo-salgado-2026-term/104936>`_",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T19:41:27.597180Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:0",
