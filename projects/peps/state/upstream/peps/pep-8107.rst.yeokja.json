      "source_hash": 3730782753487585816,
      "context_hash": 13776159363310969058,
      "translation": "`Savannah Ostrowski <https://discuss.python.org/t/steering-council-nomination-savannah-ostrowski-2026-term/104989>`_",
      "glossary_snapshot": {},
