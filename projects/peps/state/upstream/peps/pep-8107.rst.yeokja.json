      "issues": []
    },
    {
      "id": "section:4/block:5/seg:1",
      "source": "Smith <https://discuss.python.org/t/steering-council-nomination-gregory-p-smith-2026-term/105011>`_",
      "source_hash": 11040851076881635790,
      "context_hash": 13916370915012603297,
