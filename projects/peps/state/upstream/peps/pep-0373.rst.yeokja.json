  "version": 1,
  "source_hash": 2919460796914507149,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Python 2.7 Release Schedule",
      "source_hash": 2723477085944934479,
      "context_hash": 16530898886277989957,
      "translation": "Python 2.7 릴리스 일정",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825925Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 4536207216027579456,
      "translation": "개요",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825928Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This document describes the development and release schedule for Python 2.7.",
      "source_hash": 14313713216048110783,
      "context_hash": 16435461555323457359,
      "translation": "이 문서는 Python 2.7의 개발 및 릴리스 일정을 설명합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825928Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Python 2.7 is the end of the Python 2.x series, and is succeeded by Python 3.",
      "source_hash": 12683437840702067057,
      "context_hash": 11062106927743020167,
      "translation": "Python 2.7은 Python 2.x 시리즈의 마지막 버전이며, Python 3이 그 뒤를 잇습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825929Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:1",
      "source": "See `the \"Sunsetting Python 2\" FAQ on python.org <https://www.python.org/doc/sunset-python-2/>`_ for a general overview.",
      "source_hash": 12722808958219662021,
      "context_hash": 15723146586840067607,
      "translation": "전반적인 개요는 `python.org의 \"Sunsetting Python 2\" FAQ <https://www.python.org/doc/sunset-python-2/>`_\\ 를 참조하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825929Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Update (April 2014)",
      "source_hash": 15049787581233770996,
      "context_hash": 314427027798462468,
      "translation": "업데이트 (2014년 4월)",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825929Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The End Of Life date (EOL, sunset date) for Python 2.7 has been moved five years into the future, to 2020.",
      "source_hash": 1760288161372937565,
      "context_hash": 267690873745239029,
      "translation": "Python 2.7의 지원 종료일(EOL, sunset date)이 5년 뒤인 2020년으로 연기되었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825930Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "This decision was made to clarify the status of Python 2.7 and relieve worries for those users who cannot yet migrate to Python 3.",
      "source_hash": 2285508501475750200,
      "context_hash": 14028512185808078059,
      "translation": "이 결정은 Python 2.7의 상태를 명확히 하고, 아직 Python 3으로 이전할 수 없는 사용자들의 우려를 덜어주기 위해 내려졌습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825931Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:2",
      "source": "See also :pep:`466`.",
      "source_hash": 13936233614107431643,
      "context_hash": 5955122470498948624,
      "translation": "자세한 내용은 :pep:`466`\\ 도 참조하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825931Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "This declaration does not guarantee that bugfix releases will be made on a regular basis, but it should enable volunteers who want to contribute bugfixes for Python 2.7 and it should satisfy vendors who still have to support Python 2 for years to come.",
      "source_hash": 14616236771710112376,
      "context_hash": 6688024044021057326,
      "translation": "이 발표가 버그 수정 릴리스가 정기적으로 이루어질 것을 보장하지는 않지만, Python 2.7에 버그 수정을 기여하고자 하는 자원봉사자들에게 도움이 될 것이며, 앞으로 수년간 Python 2를 계속 지원해야 하는 벤더들도 만족시킬 수 있을 것입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825931Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "There will be no Python 2.8 (see :pep:`404`).",
      "source_hash": 14084727115397661200,
      "context_hash": 15636435003627295228,
      "translation": "Python 2.8은 없을 것입니다(:pep:`404` 참조).",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:23:53.825931Z",
      "issues": []
    },
