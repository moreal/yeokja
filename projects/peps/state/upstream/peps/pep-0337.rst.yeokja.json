    {
      "id": "section:5/block:30/seg:0",
      "source": "Finally possibly some modules should be extended to provide more debug information.",
      "source_hash": 2639762446910518437,
      "context_hash": 2480077662122619457,
      "translation": "마지막으로 더 많은 디버그 정보를 제공하도록 확장해야 할 모듈이 있을 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-08-28T17:10:40.527576Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Doubtful Modules",
      "source_hash": 4578927459748547887,
      "context_hash": 13706714672039497439,
      "translation": "미확정 모듈",
      "glossary_snapshot": {},
