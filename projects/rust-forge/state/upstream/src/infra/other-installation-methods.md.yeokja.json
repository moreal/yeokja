    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "If you want to build the Rust toolchain from source code, you can use the following links to download source code tarballs.",
      "source_hash": 15453586047907329515,
      "context_hash": 10696355879418923628,
      "translation": "Rust 툴체인을 소스 코드에서 빌드하고 싶다면, 다음 링크를 이용해 소스 코드 tarball을 다운로드할 수 있습니다.",
      "glossary_snapshot": {
        "Rust": "Rust",
        "toolchain": "툴체인"
      },
      "translated_at": "2026-09-04T13:18:40.614899Z",
      "issues": []
    },
