      "source_hash": 6209732883477737445,
      "context_hash": 7068674369090629078,
      "translation": "<span id=\"rustup\"></span>",
      "glossary_snapshot": {
        "rustup": "rustup"
      },
      "translated_at": "2026-09-04T13:18:40.614899Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Please refer to `rustup`'s [Other installation methods](https://rust-lang.github.io/rustup/installation/other.html).",
      "source_hash": 18050548451050591880,
      "context_hash": 247131524189870134,
      "translation": "`rustup`의 [다른 설치 방법](https://rust-lang.github.io/rustup/installation/other.html)을 참조하십시오.",
      "glossary_snapshot": {},
