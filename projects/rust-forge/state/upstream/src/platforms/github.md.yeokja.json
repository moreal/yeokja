    {
      "id": "section:2/block:0/seg:0",
      "source": "rust-lang organization policy",
      "source_hash": 6497483045411913776,
      "context_hash": 4638497575756687025,
      "translation": "rust-lang 조직 정책",
      "glossary_snapshot": {
        "Rust": "Rust"
      },
      "translated_at": "2026-09-04T13:17:04.386473Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The following is the policy for management of the [`rust-lang`] organization.",
      "source_hash": 11284450022589108013,
      "context_hash": 17457470376145338572,
      "translation": "다음은 [`rust-lang`] 조직의 관리에 관한 정책입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:40:56.354255Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Access",
      "source_hash": 9660290532684021304,
      "context_hash": 9222160007954277910,
      "translation": "접근 권한",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:40:56.354255Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "All access to the `rust-lang` GitHub organization is managed via the [`team` repository][team][^team-policy].",
      "source_hash": 10126964085618692869,
      "context_hash": 14107798767756409900,
      "translation": "`rust-lang` GitHub 조직에 대한 모든 접근 권한은 [`team` 저장소][team][^team-policy]를 통해 관리됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:40:56.354255Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:1",
      "source": "Teams that want to assign access levels, or create new repositories should open a Pull Request to that repository to request the change.",
      "source_hash": 1968468870750112617,
      "context_hash": 15289092895928366910,
      "translation": "접근 수준을 부여하거나 새 저장소를 생성하고자 하는 팀은 해당 저장소에 풀 리퀘스트를 열어 변경을 요청해야 합니다.",
      "glossary_snapshot": {
        "pull request": "풀 리퀘스트"
      },
      "translated_at": "2026-09-04T12:40:56.354255Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "The [Infrastructure Team] is responsible for overall administration of the `rust-lang` GitHub organization.",
      "source_hash": 18089071635763946026,
      "context_hash": 5019829467030903361,
      "translation": "[인프라 팀]은 `rust-lang` GitHub 조직의 전반적인 관리를 담당합니다.",
      "glossary_snapshot": {
        "infrastructure team": "인프라 팀"
      },
      "translated_at": "2026-09-04T13:17:04.386473Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:1",
      "source": "Selected members of the Infrastructure Team may be organization owners if their work requires it.",
      "source_hash": 15214588759795081163,
      "context_hash": 7408396036459570371,
      "translation": "인프라 팀의 선정된 구성원은 그 업무에 필요한 경우 조직 소유자가 될 수 있습니다.",
      "glossary_snapshot": {
        "infrastructure team": "인프라 팀"
      },
      "translated_at": "2026-09-04T13:17:04.386473Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "All GitHub accounts used to interact with the Rust-Lang GitHub organization (owner or non-owner) must have [2FA] enabled.",
      "source_hash": 13147625796071184774,
      "context_hash": 8227353225106315821,
      "translation": "Rust-Lang GitHub 조직과 상호작용하는 데 사용되는 모든 GitHub 계정(소유자든 아니든)은 [2FA]가 활성화되어 있어야 합니다.",
      "glossary_snapshot": {
        "Rust": "Rust"
      },
      "translated_at": "2026-09-04T13:17:04.386474Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:1",
      "source": "This is enforced by GitHub.",
      "source_hash": 10719301460941365967,
      "context_hash": 17487250721345991377,
      "translation": "이는 GitHub에 의해 강제됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:40:56.354255Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
      "source": "Bot accounts controlled by the Infrastructure Team (such as the triagebot) can be granted any level of access required for them to work at the discretion of the Infrastructure Team.",
      "source_hash": 10129471564296442802,
      "context_hash": 13721011280920037780,
      "translation": "인프라 팀이 관리하는 봇 계정(triagebot 등)은 인프라 팀의 재량에 따라 작업에 필요한 어떤 수준의 접근 권한도 부여받을 수 있습니다.",
      "glossary_snapshot": {
        "triagebot": "triagebot",
        "infrastructure team": "인프라 팀"
      },
      "translated_at": "2026-09-04T13:17:04.386474Z",
      "issues": []
    },
    {
      "id": "section:2/block:7/seg:0",
      "source": "See [Team Maintenance](../infra/team-maintenance.md) for policy on how the team repo is managed.",
      "source_hash": 15790583496232354715,
      "context_hash": 4722289497880940155,
      "translation": "team 저장소가 관리되는 방식에 관한 정책은 [Team Maintenance](../infra/team-maintenance.md)를 참고하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:40:56.354256Z",
      "issues": []
    }
  ]
}