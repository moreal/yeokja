      "issues": []
    },
    {
      "id": "section:0/block:1/seg:2",
      "source": "These updates are currently managed by [`@ehuss`](https://github.com/ehuss/).",
      "source_hash": 7121736189631269736,
      "context_hash": 4463454727620388562,
      "translation": "이러한 업데이트는 현재 [`@ehuss`](https://github.com/ehuss/)가 관리하고 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:24.294324Z",
