    {
      "id": "section:0/block:1/seg:0",
      "source": "Triagebot automatically generates a PR to [`rust-lang/rust`](https://github.com/rust-lang/rust/) every two weeks that updates all of the book submodules.",
      "source_hash": 1412260241493728534,
      "context_hash": 6281605372527861403,
      "translation": "Triagebot은 2주마다 자동으로 [`rust-lang/rust`](https://github.com/rust-lang/rust/)에 모든 book 서브모듈을 업데이트하는 PR을 생성합니다.",
      "glossary_snapshot": {
        "triagebot": "triagebot"
      },
      "translated_at": "2026-09-04T13:17:26.904722Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "This PR requires manual approval.",
      "source_hash": 15859146980137326612,
      "context_hash": 7366805014089600220,
      "translation": "이 PR은 수동 승인이 필요합니다.",
      "glossary_snapshot": {},
