  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "GitHub Actions created PR open/closer",
      "source_hash": 14958615882070188259,
      "context_hash": 891723099684660917,
      "translation": "GitHub Actions가 생성한 PR을 열고 닫는 기능",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:03.989325Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "This automation triggers an automatic close & reopen on PRs opened by the `github-actions` user, i.e., from a GitHub actions job.",
      "source_hash": 13349212044669603142,
      "context_hash": 16691896359153198216,
      "translation": "이 자동화는 `github-actions` 사용자, 즉 GitHub Actions 작업에 의해 열린 PR에 대해 자동으로 닫기 & 다시 열기를 트리거합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:03.989326Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "This enables CI to run on those PRs without needing a manual poke from some human.",
      "source_hash": 5510876318686131296,
      "context_hash": 2949909044845176349,
      "translation": "이를 통해 사람이 수동으로 손대지 않아도 해당 PR에서 CI가 실행될 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:03.989326Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 2645627131503184287,
      "translation": "설정",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:03.989327Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This feature is enabled on a repository by having a `[bot-pull-requests]` table in `triagebot.toml`:",
      "source_hash": 16944815827114088406,
      "context_hash": 5476116926316283150,
      "translation": "이 기능은 `triagebot.toml`에 `[bot-pull-requests]` 테이블을 두면 저장소에서 활성화됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:03.989327Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Implementation",
      "source_hash": 14188291987651099077,
      "context_hash": 15664731041271037857,
      "translation": "구현",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:44:03.989327Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "See [`src/handlers/bot_pull_requests.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/bot_pull_requests.rs).",
      "source_hash": 18098161159652016849,
      "context_hash": 5801226501789644448,
      "translation": "[`src/handlers/bot_pull_requests.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/bot_pull_requests.rs)를 참조하십시오.",
