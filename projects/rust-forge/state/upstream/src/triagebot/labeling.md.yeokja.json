      "issues": []
    },
    {
      "id": "section:1/block:17/seg:0",
      "source": "&nbsp;&nbsp; &nbsp;&nbsp; `label`",
      "source_hash": 1159950589579906147,
      "context_hash": 9230786349632052391,
      "translation": "&nbsp;&nbsp; &nbsp;&nbsp; `label`",
