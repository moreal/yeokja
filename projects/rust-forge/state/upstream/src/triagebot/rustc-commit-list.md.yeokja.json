  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Rustc Commit Tracking",
      "source_hash": 8964121484053441727,
      "context_hash": 11425021192121268927,
      "translation": "Rustc 커밋 추적",
      "glossary_snapshot": {
        "rustc": "rustc"
      },
      "translated_at": "2026-09-04T13:18:21.569277Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Triagebot keeps a database of commits to the [`rust-lang/rust`](https://github.com/rust-lang/rust/) repository.",
      "source_hash": 403119666737196835,
      "context_hash": 4524131321712094420,
      "translation": "Triagebot는 [`rust-lang/rust`](https://github.com/rust-lang/rust/) 저장소에 대한 커밋 데이터베이스를 유지합니다.",
      "glossary_snapshot": {
        "triagebot": "triagebot"
      },
      "translated_at": "2026-09-04T13:18:21.569278Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "This is useful since the GitHub API for fetching this information can be slow.",
      "source_hash": 10715195816379573823,
      "context_hash": 15225177350830450622,
      "translation": "이 정보를 가져오기 위한 GitHub API가 느릴 수 있기 때문에 이는 유용합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:31.187227Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:2",
      "source": "For example, this is used by the [rustc-perf](https://github.com/rust-lang/rustc-perf) system.",
      "source_hash": 5548072641866286459,
      "context_hash": 6312254329593270730,
      "translation": "이 정보를 가져오는 GitHub API가 느릴 수 있기 때문에 이는 유용합니다. 예를 들어, [rustc-perf](https://github.com/rust-lang/rustc-perf) 시스템에서 이를 사용합니다.",
      "glossary_snapshot": {
        "rustc": "rustc"
      },
      "translated_at": "2026-09-04T13:18:21.569278Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Usage",
      "source_hash": 8769925957682373409,
      "context_hash": 13259237915700050782,
      "translation": "사용법",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:31.187227Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "The top-level bors merge commits can be fetched from <https://triage.rust-lang.org/bors-commit-list>.",
      "source_hash": 17335564893434143747,
      "context_hash": 9385859031228025378,
      "translation": "최상위 bors 병합 커밋은 <https://triage.rust-lang.org/bors-commit-list>에서 가져올 수 있습니다.",
      "glossary_snapshot": {
        "bors": "bors"
      },
      "translated_at": "2026-09-04T13:18:21.569278Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 16592464145980014403,
      "translation": "설정",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:31.187227Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "This has no configuration, it is processed automatically.",
      "source_hash": 11388976984130573929,
      "context_hash": 5476116926316283150,
      "translation": "이는 설정이 없으며 자동으로 처리됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:31.187227Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Implementation",
      "source_hash": 14188291987651099077,
      "context_hash": 13262659196108970472,
      "translation": "구현",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:31.187227Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "See [`src/db/rustc_commits.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/db/rustc_commits.rs) and [`src/handlers/rustc_commits.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/rustc_commits.rs).",
      "source_hash": 412169426785738510,
      "context_hash": 5801226501789644448,
      "translation": "[`src/db/rustc_commits.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/db/rustc_commits.rs)와 [`src/handlers/rustc_commits.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/rustc_commits.rs)를 참고하십시오.",
