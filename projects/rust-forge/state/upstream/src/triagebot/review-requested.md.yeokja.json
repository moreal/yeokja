  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Review Requested",
      "source_hash": 16649599635482242466,
      "context_hash": 18367881127771656500,
      "translation": "리뷰 요청됨",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565818Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "This feature will automatically adjust the labels on a pull request when the PR author requests a review from an assignee.",
      "source_hash": 7424328410389401584,
      "context_hash": 7627077102939826097,
      "translation": "이 기능은 PR 작성자가 담당자에게 리뷰를 요청할 때 풀 리퀘스트의 라벨을 자동으로 조정합니다.",
      "glossary_snapshot": {
        "pull request": "풀 리퀘스트"
      },
      "translated_at": "2026-09-04T12:46:05.565819Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Usage",
      "source_hash": 8769925957682373409,
      "context_hash": 13872965020014355265,
      "translation": "사용법",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565820Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "In the list of reviewers, click the \"Re-request review\" button near an assignee's name.",
      "source_hash": 133355375477127011,
      "context_hash": 12065869852423337223,
      "translation": "리뷰어 목록에서 담당자 이름 옆에 있는 \"Re-request review\" 버튼을 클릭하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565820Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "This will automatically remove the \"waiting on the author\" labels, and add a new labels to indicate that the PR is waiting on the review.",
      "source_hash": 17751175991877916903,
      "context_hash": 5041930987865662903,
      "translation": "이렇게 하면 \"waiting on the author\" 라벨이 자동으로 제거되고, PR이 리뷰를 기다리고 있음을 나타내는 새 라벨이 추가됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565820Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 4315207663672306763,
      "translation": "설정",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565820Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "This feature is enabled on a repository by having a `[review-requested]` table in `triagebot.toml`:",
      "source_hash": 16285732390182178693,
      "context_hash": 5476116926316283150,
      "translation": "이 기능은 `triagebot.toml`에 `[review-requested]` 테이블을 두어 저장소에서 활성화합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565820Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Implementation",
      "source_hash": 14188291987651099077,
      "context_hash": 9808166165156812294,
      "translation": "구현",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565821Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "See [`src/handlers/review_requested.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/review_requested.rs).",
      "source_hash": 3519077060975529701,
      "context_hash": 5801226501789644448,
      "translation": "[`src/handlers/review_requested.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/review_requested.rs)를 참고하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:05.565821Z",
      "issues": []
    }
  ]
