  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Rendered link",
      "source_hash": 2665874161331566970,
      "context_hash": 16306705443570247494,
      "translation": "렌더링된 링크",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249600Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Rendered links are simple hyperlinks that are automatically added (and updated) to a PR description by triagebot.",
      "source_hash": 13136909850064936190,
      "context_hash": 1282097983644621804,
      "translation": "렌더링된 링크는 triagebot에 의해 PR 설명에 자동으로 추가(및 업데이트)되는 단순한 하이퍼링크입니다.",
      "glossary_snapshot": {
        "triagebot": "triagebot"
      },
      "translated_at": "2026-09-04T13:18:09.763260Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 14968652586523728600,
      "translation": "설정",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249600Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "This feature is enabled on a repository by having a `[rendered-link]` table in `triagebot.toml`:",
      "source_hash": 14543841224576830388,
      "context_hash": 4614973241283072255,
      "translation": "이 기능은 `triagebot.toml`에 `[rendered-link]` 테이블을 포함시킴으로써 저장소에서 활성화됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249600Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "The `trigger-files` key configures which directories are watched for modification, with the `exclude-files` key to exclude files or directories.",
      "source_hash": 13492610978628240741,
      "context_hash": 15386702956314837063,
      "translation": "`trigger-files` 키는 수정 여부를 감시할 디렉터리를 설정하며, `exclude-files` 키로 파일이나 디렉터리를 제외할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249600Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "The \"Rendered link\" will point to the matching file with the most modifications.",
      "source_hash": 6880124983295609863,
      "context_hash": 16916214136915938343,
      "translation": "\"렌더링된 링크\"는 가장 많이 수정된 일치 파일을 가리킵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249601Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Implementation",
      "source_hash": 14188291987651099077,
      "context_hash": 20418892005493421,
      "translation": "구현",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249601Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "See [`src/handlers/rendered_link.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/rendered_link.rs).",
      "source_hash": 8749752907176854296,
      "context_hash": 5801226501789644448,
      "translation": "[`src/handlers/rendered_link.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/rendered_link.rs)를 참고하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:46:02.249601Z",
      "issues": []
    }
  ]
}