  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Lock",
      "source_hash": 6515525952523017979,
      "context_hash": 18381376882106838226,
      "translation": "잠금",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462390Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "The `lock`/`unlock` commands can be used to lock and unlock a GitHub issue or pull request.",
      "source_hash": 8135400119748818061,
      "context_hash": 18441944302212274331,
      "translation": "`lock`/`unlock` 명령은 GitHub 이슈나 풀 리퀘스트를 잠그거나 잠금 해제하는 데 사용할 수 있습니다.",
      "glossary_snapshot": {
        "issue": "이슈",
        "pull request": "풀 리퀘스트"
      },
      "translated_at": "2026-09-04T12:47:48.462390Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Usage",
      "source_hash": 8769925957682373409,
      "context_hash": 4627476820442590949,
      "translation": "사용법",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462391Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Lock",
      "source_hash": 6515525952523017979,
      "context_hash": 4482336395691387764,
      "translation": "잠금",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462391Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "To lock an issue or pull request, any rust-lang team member may enter the command:",
      "source_hash": 10549752117786426575,
      "context_hash": 15077205783583268286,
      "translation": "이슈나 풀 리퀘스트를 잠그려면, rust-lang 언어 팀 구성원이라면 누구나 다음 명령을 입력할 수 있습니다:",
      "glossary_snapshot": {
        "issue": "이슈",
        "team member": "팀 구성원",
        "lang team": "언어 팀",
        "Rust": "Rust",
        "pull request": "풀 리퀘스트"
      },
      "translated_at": "2026-09-04T13:18:11.792099Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "This will immediately lock the issue or PR.",
      "source_hash": 7060558727248328641,
      "context_hash": 1641108645330278469,
      "translation": "이렇게 하면 이슈 또는 PR이 즉시 잠깁니다.",
      "glossary_snapshot": {
        "issue": "이슈"
      },
      "translated_at": "2026-09-04T12:47:48.462391Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Unlock",
      "source_hash": 11078127757487119335,
      "context_hash": 80537663517072673,
      "translation": "잠금 해제",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462391Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "To unlock an issue or pull request, any rust-lang team member may enter the command:",
      "source_hash": 1374350613583243103,
      "context_hash": 8337584166573663592,
      "translation": "이슈나 풀 리퀘스트의 잠금을 해제하려면, rust-lang 언어 팀 구성원이라면 누구나 다음 명령을 입력할 수 있습니다:",
      "glossary_snapshot": {
        "lang team": "언어 팀",
        "issue": "이슈",
        "Rust": "Rust",
        "pull request": "풀 리퀘스트",
        "team member": "팀 구성원"
      },
      "translated_at": "2026-09-04T13:18:11.792103Z",
      "issues": []
    },
    {
      "id": "section:1/block:8/seg:0",
      "source": "[!NOTE] The triagebot Zulip `unlock` command can be used in case it's not possible for the team member to post a command.",
      "source_hash": 1071207037541877752,
      "context_hash": 1995514415042155432,
      "translation": "[!NOTE] triagebot Zulip `unlock` 명령은 팀 구성원이 명령을 게시할 수 없는 경우에 사용할 수 있습니다.",
      "glossary_snapshot": {
        "triagebot": "triagebot",
        "team member": "팀 구성원",
        "Zulip": "Zulip"
      },
      "translated_at": "2026-09-04T13:18:11.792104Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 11091556167731444855,
      "translation": "설정",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462392Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "[!NOTE] This feature is [enabled by default](https://github.com/rust-lang/triagebot/blob/master/rust-lang.triagebot.toml) in the rust-lang organization.",
      "source_hash": 17648849861768685535,
      "context_hash": 1826046508624379752,
      "translation": "[!NOTE] 이 기능은 rust-lang 조직에서 [기본적으로 활성화](https://github.com/rust-lang/triagebot/blob/master/rust-lang.triagebot.toml)되어 있습니다.",
      "glossary_snapshot": {
        "Rust": "Rust"
      },
      "translated_at": "2026-09-04T13:18:11.792104Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "This feature is enabled on a repository by having a `[lock]` table in `triagebot.toml`:",
      "source_hash": 5988368370005860430,
      "context_hash": 5155831482035546712,
      "translation": "이 기능은 `triagebot.toml`에 `[lock]` 테이블을 두면 저장소에서 활성화됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462392Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Implementation",
      "source_hash": 14188291987651099077,
      "context_hash": 8204506250302556242,
      "translation": "구현",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:47:48.462392Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "See [`src/handlers/lock.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/lock.rs) and [`parser/src/command/lock.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/parser/src/command/lock.rs).",
      "source_hash": 15970571588651537422,
      "context_hash": 5801226501789644448,
      "translation": "[`src/handlers/lock.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/lock.rs)와 [`parser/src/command/lock.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/parser/src/command/lock.rs)를 참고하십시오.",
