      "issues": []
    },
    {
      "id": "section:0/block:27/seg:0",
      "source": "No Tools Breakage Week",
      "source_hash": 13677345833864174844,
      "context_hash": 11813807994463501214,
      "translation": "도구 손상 없는 주간",
      "glossary_snapshot": {},
      "translated_at": "2026-09-04T12:45:37.216476Z",
      "issues": []
    },
    {
      "id": "section:0/block:28/seg:0",
      "source": "To ensure the beta release includes all the tools, no [tool breakages] are allowed in the week before the beta cutoff (except for nightly-only tools).",
      "source_hash": 2079655621944331170,
      "context_hash": 10188801717989663735,
      "translation": "beta 릴리스에 모든 도구가 포함되도록 보장하기 위해, beta 컷오프 이전 한 주 동안은 (nightly 전용 도구를 제외하고) [tool breakages]가 허용되지 않습니다.",
      "glossary_snapshot": {
        "nightly": "nightly",
        "beta": "beta"
      },
      "translated_at": "2026-09-04T13:20:05.227451Z",
      "issues": []
